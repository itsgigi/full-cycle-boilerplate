# Copia questo file in .env.local e compila i valori. .env.local non va mai committato.
# In produzione le stesse variabili si impostano nel pannello di Vercel.

# URL pubblico del sito (usato per canonical, sitemap e Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

